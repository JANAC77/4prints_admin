{
  "version": 2,
  "cleanUrls": true,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "https://api.autoneu.in/admin/:path*"
    },
    {
      "source": "/categories/:path*",
      "destination": "https://api.autoneu.in/categories/:path*"
    },
    {
      "source": "/hello",
      "destination": "https://api.autoneu.in/hello"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
